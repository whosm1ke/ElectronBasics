{
  "name": "snippet-runner",
  "version": "1.0.0",
  "description": "Local Snippet & Command Runner — Raycast/Spotlight-style PowerShell launcher for Windows",
  "license": "ISC",
  "author": "Developer",
  "type": "commonjs",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "dependencies": {
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.snippetrunner.app",
    "productName": "SnippetRunner",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "compression": "maximum",
    "electronLanguages": ["en-US", "uk"],
    "afterPack": "build/afterPack.js",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}