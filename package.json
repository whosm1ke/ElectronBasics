{
  "name": "snippet-runner",
  "version": "1.0.3",
  "description": "Local Snippet & Command Runner — Raycast/Spotlight-style PowerShell launcher for Windows",
  "license": "ISC",
  "author": "Developer",
  "type": "commonjs",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "release": "npm version patch --no-git-tag-version && electron-builder --win --publish always",
    "release:minor": "npm version minor --no-git-tag-version && electron-builder --win --publish always",
    "release:major": "npm version major --no-git-tag-version && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.snippetrunner.app",
    "productName": "SnippetRunner",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "uk"
    ],
    "afterPack": "build/afterPack.js",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "whosm1ke",
      "repo": "ElectronBasics",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
