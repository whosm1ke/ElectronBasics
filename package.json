{
  "name": "snippet-runner",
  "version": "1.0.7",
  "description": "Local Snippet & Command Runner — Raycast/Spotlight-style PowerShell launcher for Windows",
  "license": "ISC",
  "author": "Developer",
  "type": "commonjs",
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run",
    "build": "electron-vite build && electron-builder --win",
    "build:portable": "electron-vite build && electron-builder --win portable",
    "release": "npm version patch && git push && git push --tags && electron-vite build && electron-builder --win --publish always",
    "release:minor": "npm version minor && git push && git push --tags && electron-vite build && electron-builder --win --publish always",
    "release:major": "npm version major && git push && git push --tags && electron-vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@xyflow/react": "^12.11.6",
    "croner": "^10.0.1",
    "dagre": "^0.8.5",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.9",
    "fuse.js": "^7.5.0",
    "lucide": "^1.41.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "sonner": "^2.0.8",
    "write-file-atomic": "^7.0.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/diff": "^7.0.2",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.snippetrunner.app",
    "productName": "SnippetRunner",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "compression": "maximum",
    "icon": "build/icon.ico",
    "electronLanguages": [
      "en-US",
      "uk"
    ],
    "beforePack": "build/beforePack.js",
    "afterPack": "build/afterPack.js",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "whosm1ke",
      "repo": "ElectronBasics",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
