{
  "name": "snippet-runner",
  "version": "1.0.5",
  "description": "Local Snippet & Command Runner — Raycast/Spotlight-style PowerShell launcher for Windows",
  "license": "ISC",
  "author": "Developer",
  "type": "commonjs",
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run",
    "build": "electron-vite build && electron-builder --win",
    "build:portable": "electron-vite build && electron-builder --win portable",
    "release": "npm version patch && git push && git push --tags && electron-vite build && electron-builder --win --publish always",
    "release:minor": "npm version minor && git push && git push --tags && electron-vite build && electron-builder --win --publish always",
    "release:major": "npm version major && git push && git push --tags && electron-vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.snippetrunner.app",
    "productName": "SnippetRunner",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "uk"
    ],
    "afterPack": "build/afterPack.js",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "whosm1ke",
      "repo": "ElectronBasics",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
